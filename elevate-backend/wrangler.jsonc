{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elevate-backend",
  "main": "src/index.ts",
  "compatibility_date": "2024-05-29",
  "compatibility_flags": ["nodejs_compat"],

  /**
   * D1 Database
   * After running `wrangler d1 create elevate-db`, paste the returned
   * database_id value below.
   */
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elevate-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],

  /**
   * KV Namespace — used for rate-limiting
   * After running `wrangler kv namespace create RATE_LIMIT`, paste the
   * returned id value below.
   */
  "kv_namespaces": [
    {
      "binding": "RATE_LIMIT",
      "id": "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"
    }
  ]
}
